{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:css\" \"bun run dev:kit\"",
    "dev:css": "bunx tailwindcss -i ./global.css -o ../static/css/output.css --watch",
    "dev:kit": "node ./scripts/watch-kit.mjs",
    "build:css": "bunx tailwindcss -i ./global.css -o ../static/css/output.css",
    "build:kit": "vite build",
    "build": "bun run build:css && bun run build:kit",
    "copy:alpine": "mkdir -p ../static/vendor && cp ./node_modules/alpinejs/dist/cdn.min.js ../static/vendor/alpine.min.js && cp ./node_modules/@alpinejs/persist/dist/cdn.min.js ../static/vendor/alpine.persist.min.js",
    "postinstall": "bun run copy:alpine"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/bun": "latest",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "daisyui": "4.12.24",
    "postcss": "8.5.10",
    "svelte": "^5.33.0",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@alpinejs/persist": "^3.17.4",
    "alpinejs": "3.15.10",
    "d3": "^7.9.0",
    "lucide-svelte": "^0.487.0"
  }
}
